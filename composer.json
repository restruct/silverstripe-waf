{
    "name": "restruct/silverstripe-waf",
    "description": "PHP-level Web Application Firewall for Silverstripe - blocks vulnerability scanners, bad bots, and malicious IPs",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": [
        "silverstripe",
        "security",
        "waf",
        "firewall",
        "ip-blocking",
        "rate-limiting"
    ],
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.0 || ^6.0",
        "silverstripe/admin": "^2 || ^3",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "suggest": {
        "symbiote/silverstripe-queuedjobs": "Schedules the blocklist sync every 6 hours (SyncBlocklistsJob); without it, run the sync task from cron",
        "silverstripe/errorpage": "Serves a styled 429 page when use_styled_error_pages is on; without it the 429 is plain text"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\Waf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\SilverStripe\\Waf\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "installer-name": "waf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
